package it.gft.simpleapplication.dataservice.dto;

import jakarta.persistence.*;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@Table(name = "account_data")
@Entity
@AllArgsConstructor
@NoArgsConstructor
public class AccountDataDto {

    @Id
    @GeneratedValue(strategy = GenerationType.SEQUENCE, generator = "address_seq")
    @SequenceGenerator(name = "account_data_seq", sequenceName = "account_data_sequence", initialValue = 1, allocationSize = 1)
    @Column(name = "id_account_data")
    private Long idAccountData;

    @Column(name = "name")
    private String name;

    @Column(name = "surname")
    private String surname;

    @Column(name = "phone_number")
    private Long phoneNumber;

    @Column(name = "email")
    private String email;

}
